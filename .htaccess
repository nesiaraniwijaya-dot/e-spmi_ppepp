<IfModule mod_rewrite.c>
    RewriteEngine On

    # Direct access to assets, uploads, and existing files
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other requests to index.php (Works on both Localhost and Hosting)
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
